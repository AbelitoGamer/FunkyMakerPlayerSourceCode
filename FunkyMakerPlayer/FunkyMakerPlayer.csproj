<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>0.5.0</Version>
    <AssemblyVersion>0.5.0</AssemblyVersion>
    <!-- Disable Mono runtime requirement to use CoreCLR instead -->
    <UseMonoRuntime>false</UseMonoRuntime>
    <!-- Icon and manifest only apply on Windows builds -->
    <ApplicationManifest Condition="'$(RuntimeIdentifier)' != 'linux-x64' And !$(TargetFramework.Contains('android'))">app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="'$(RuntimeIdentifier)' != 'linux-x64' And !$(TargetFramework.Contains('android'))">Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Android-specific properties -->
  <PropertyGroup Condition="$(TargetFramework.Contains('android'))">
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <ApplicationId>com.funkymakergame.player</ApplicationId>
    <ApplicationTitle>FunkyMaker Player</ApplicationTitle>
    <ApplicationVersion>8</ApplicationVersion>
    <ApplicationDisplayVersion>0.5.0</ApplicationDisplayVersion>
    <AndroidVersionCode>8</AndroidVersionCode>
    <AndroidManifest>Platforms\Android\AndroidManifest.xml</AndroidManifest>
    <!-- Disable AOT for now to avoid trimming issues -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <!-- Disable Fast Deployment to fix native library loading -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
  </PropertyGroup>
  
  <!-- Android Release Signing Configuration -->
  <!-- Passwords are read from environment variables so they never end up in the repo.
       Set FUNKY_STORE_PASS and FUNKY_KEY_PASS before building a Release APK. -->
  <PropertyGroup Condition="$(TargetFramework.Contains('android')) And '$(Configuration)' == 'Release'">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(MSBuildProjectDirectory)\..\funkymakergame.keystore</AndroidSigningKeyStore>
    <AndroidSigningStorePass>$([System.Environment]::GetEnvironmentVariable('FUNKY_STORE_PASS'))</AndroidSigningStorePass>
    <AndroidSigningKeyAlias>funkymakergame</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>$([System.Environment]::GetEnvironmentVariable('FUNKY_KEY_PASS'))</AndroidSigningKeyPass>
  </PropertyGroup>

  <Target Name="CheckAndroidSigningSecrets" BeforeTargets="SignAndroidPackage"
          Condition="$(TargetFramework.Contains('android')) And '$(Configuration)' == 'Release'">
    <Error Condition="'$(AndroidSigningStorePass)' == '' Or '$(AndroidSigningKeyPass)' == ''"
           Text="Android Release: set the FUNKY_STORE_PASS and FUNKY_KEY_PASS environment variables before building." />
  </Target>
  
  <!-- Android Release configuration: support multiple ABIs (arm64-v8a, x86_64) -->
  <PropertyGroup Condition="$(TargetFramework.Contains('android')) And '$(Configuration)' == 'Release'">
    <AndroidSupportedAbis>arm64-v8a;x86_64</AndroidSupportedAbis>
  </PropertyGroup>
  
  <!-- Single-file publish configuration (both platforms) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And !$(TargetFramework.Contains('android'))">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <!-- Bundle ALL managed assemblies into the single exe, including NuGet deps -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- Windows-specific: WinExe hides the console, app.manifest, icon.
       Applies to `publish -r win-x64` AND to a plain `build -c Release` on Windows (no RID). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And !$(TargetFramework.Contains('android')) And ('$(RuntimeIdentifier)' == 'win-x64' Or ('$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT'))">
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Linux-specific: keep Exe (no WinExe on Linux) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(RuntimeIdentifier)' == 'linux-x64'">
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  
  <!-- Exclude Legacy folder from compilation -->
  <ItemGroup>
    <Compile Remove="Legacy\**" />
    <EmbeddedResource Remove="Legacy\**" />
    <None Remove="Legacy\**" />
  </ItemGroup>
  
  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  
  <!-- Copy Assets folder to output directory -->
  <ItemGroup>
    <None Include="..\Assets\**\*.*" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Android: Include Assets folder as AndroidAsset (embedded in APK) -->
  <ItemGroup Condition="$(TargetFramework.Contains('android'))">
    <AndroidAsset Include="..\Assets\**\*.*" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Default mods (default note style, countdown, font + README/template files).
       Shipped as mods/ next to the exe; DefaultMods.EnsureInstalled() copies missing files
       into the real mods folder at startup (single-file publish / Android). -->
  <ItemGroup>
    <None Include="..\DefaultMods\**\*.*" Link="mods\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Android: default mods as AndroidAsset (APK path mods/...), extracted by DefaultMods -->
  <ItemGroup Condition="$(TargetFramework.Contains('android'))">
    <AndroidAsset Include="..\DefaultMods\**\*.*" Link="Assets\mods\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Android: Include Resources -->
  <ItemGroup Condition="$(TargetFramework.Contains('android'))">
    <AndroidResource Include="Platforms\Android\Resources\values\strings.xml" />
    <AndroidResource Include="Platforms\Android\Resources\values\styles.xml" />
    <AndroidResource Include="Platforms\Android\Resources\drawable\splash.xml" />
    <AndroidResource Include="Platforms\Android\Resources\mipmap-mdpi\icon.png" />
    <AndroidResource Include="Platforms\Android\Resources\mipmap-hdpi\icon.png" />
    <AndroidResource Include="Platforms\Android\Resources\mipmap-xhdpi\icon.png" />
    <AndroidResource Include="Platforms\Android\Resources\mipmap-xxhdpi\icon.png" />
    <AndroidResource Include="Platforms\Android\Resources\mipmap-xxxhdpi\icon.png" />
  </ItemGroup>

  <!-- Copy Icon.ico next to the exe (like FNF does) -->
  <ItemGroup>
    <None Include="Icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Icon.ico</Link>
    </None>
    <None Include="version.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>version.txt</Link>
    </None>
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.8" />
    <PackageReference Include="MonoGame.Extended" Version="6.1.1" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" Condition="!$(TargetFramework.Contains('android'))" />
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.*" Condition="$(TargetFramework.Contains('android'))" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="NLayer" Version="1.16.0" /> <!-- MP3 decoding for menu music -->
    <PackageReference Include="Obfuscar" Version="2.2.50">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SharpCompress" Version="0.39.0">
      <ExcludeAssets>none</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="DiscordRichPresence" Version="1.2.1.24" Condition="!$(TargetFramework.Contains('android'))" />
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.3.7" />
    <!-- AndroidX.DocumentFile for SAF (Storage Access Framework) support -->
    <PackageReference Include="Xamarin.AndroidX.DocumentFile" Version="1.0.1.14" Condition="$(TargetFramework.Contains('android'))" />
  </ItemGroup>
  
  <!-- Windows Forms for file dialog (Windows only) -->
  <ItemGroup Condition="!$(TargetFramework.Contains('android'))">
    <PackageReference Include="System.Windows.Forms" Version="4.0.0" />
  </ItemGroup>
  
  <!-- Native libraries not needed for WindowsDX (DirectX is built into Windows) -->

  <!-- Ensure native libraries (SDL2.dll, etc.) are included in single-file publish -->
  <Target Name="IncludeNativeLibraries" AfterTargets="Publish">
    <ItemGroup>
      <NativeLibs Include="$(PublishDir)runtimes\**\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeLibs)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Obfuscar: Solo en Release y solo para .NET (no Android) -->
  <!-- DESHABILITADO TEMPORALMENTE - usar script manual -->
  <!--
  <Target Name="ObfuscateAssembly" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' And !$(TargetFramework.Contains('android'))">
    <Exec Command="dotnet tool restore" />
    <Exec Command="dotnet tool run obfuscar obfuscar.xml" WorkingDirectory="$(ProjectDir)" />
  </Target>
  -->
</Project>